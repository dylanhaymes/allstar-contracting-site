<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <title><%= title %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' && description ? description : defaultDescription %>" />
  <meta name="robots" content="index, follow" />
  <meta name="language" content="English" />
  <meta name="author" content="All Star Contracting & Seamless Gutters LLC" />
  <meta name="theme-color" content="#E8640A" />

  <!-- Canonical -->
  <link rel="canonical" href="<%= siteUrl + (typeof canonicalPath !== 'undefined' && canonicalPath ? canonicalPath : path) %>" />

  <!-- OpenGraph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="<%= siteName %>" />
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="<%= typeof description !== 'undefined' && description ? description : defaultDescription %>" />
  <meta property="og:url" content="<%= siteUrl + (typeof canonicalPath !== 'undefined' && canonicalPath ? canonicalPath : path) %>" />
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : defaultOgImage %>" />
  <meta property="og:image:alt" content="All Star Contracting & Seamless Gutters LLC in Syracuse, NY" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= title %>" />
  <meta name="twitter:description" content="<%= typeof description !== 'undefined' && description ? description : defaultDescription %>" />
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : defaultOgImage %>" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/style.css" />

  <!-- Favicons -->
  <link rel="icon" type="image/png" href="/images/All-Star-V2.png" />
  <link rel="apple-touch-icon" href="/images/All-Star-V2.png" />

  <!-- ─── JSON-LD: LocalBusiness ─────────────────────────────────────────── -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "GeneralContractor",
    "@id": "<%= siteUrl %>/#business",
    "name": "All Star Contracting & Seamless Gutters LLC",
    "alternateName": "All Star Contracting",
    "url": "<%= siteUrl %>",
    "logo": "<%= siteUrl %>/images/All-Star-V2.png",
    "image": "<%= siteUrl %>/images/2-story-House-seamless-gutters-installed.jpg",
    "description": "<%= defaultDescription %>",
    "telephone": "+1-315-565-9230",
    "email": "allstarguttersjamie@gmail.com",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "2913 Milton Ave",
      "addressLocality": "Solvay",
      "addressRegion": "NY",
      "postalCode": "13209",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 43.0584,
      "longitude": -76.2114
    },
    "areaServed": [
      { "@type": "City", "name": "Syracuse, NY" },
      { "@type": "City", "name": "Solvay, NY" },
      { "@type": "City", "name": "Liverpool, NY" },
      { "@type": "City", "name": "Camillus, NY" },
      { "@type": "City", "name": "Baldwinsville, NY" },
      { "@type": "City", "name": "Fairmount, NY" },
      { "@type": "City", "name": "Manlius, NY" },
      { "@type": "City", "name": "East Syracuse, NY" },
      { "@type": "City", "name": "DeWitt, NY" },
      { "@type": "City", "name": "Fayetteville, NY" },
      { "@type": "City", "name": "North Syracuse, NY" },
      { "@type": "City", "name": "Clay, NY" },
      { "@type": "City", "name": "Cicero, NY" },
      { "@type": "City", "name": "Marcellus, NY" },
      { "@type": "AdministrativeArea", "name": "Central New York" }
    ],
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
        "opens": "08:00",
        "closes": "18:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": "Saturday",
        "opens": "09:00",
        "closes": "15:00"
      }
    ],
    "sameAs": [
      "https://facebook.com/Allstarseamlessgutters2014/"
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Seamless Gutter Installation", "url": "<%= siteUrl %>/seamless-gutters" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Construction & Renovations", "url": "<%= siteUrl %>/contracting" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Excavating Services", "url": "<%= siteUrl %>/excavating" } }
      ]
    }
  }
  </script>

  <!-- ─── JSON-LD: Organization ──────────────────────────────────────────── -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "<%= siteUrl %>/#organization",
    "name": "All Star Contracting & Seamless Gutters LLC",
    "url": "<%= siteUrl %>",
    "logo": "<%= siteUrl %>/images/All-Star-V2.png",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+1-315-565-9230",
      "contactType": "customer service",
      "email": "allstarguttersjamie@gmail.com",
      "areaServed": "US-NY",
      "availableLanguage": ["English"]
    },
    "sameAs": [
      "https://facebook.com/Allstarseamlessgutters2014/"
    ]
  }
  </script>

  <!-- ─── JSON-LD: WebSite ───────────────────────────────────────────────── -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "<%= siteUrl %>/#website",
    "url": "<%= siteUrl %>",
    "name": "All Star Contracting & Seamless Gutters LLC",
    "publisher": { "@id": "<%= siteUrl %>/#organization" },
    "inLanguage": "en-US"
  }
  </script>

  <% if (path && path !== '/') { %>
  <!-- ─── JSON-LD: BreadcrumbList ─────────────────────────────────────────── -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "<%= siteUrl %>/" },
      { "@type": "ListItem", "position": 2, "name": "<%= title.split(' | ')[0] %>", "item": "<%= siteUrl + path %>" }
    ]
  }
  </script>
  <% } %>
</head>
<body>

  <!-- ===== HEADER ===== -->
  <header class="site-header" id="site-header">
    <div class="header-inner container">
      <a href="/" class="logo-link" aria-label="All Star Contracting Home">
        <img src="/images/All-Star-V2.png" alt="All Star Contracting & Seamless Gutters LLC Logo" class="logo-img" />
      </a>

      <button class="hamburger" id="hamburger" aria-label="Toggle navigation" aria-expanded="false" aria-controls="main-nav">
        <span class="ham-bar"></span>
        <span class="ham-bar"></span>
        <span class="ham-bar"></span>
      </button>

      <nav class="main-nav" id="main-nav" role="navigation" aria-label="Main navigation">
        <ul class="nav-list">
          <li><a href="/" class="nav-link<%= path === '/' ? ' active' : '' %>">Home</a></li>
          <li><a href="/services" class="nav-link<%= path === '/services' ? ' active' : '' %>">Services</a></li>
          <li><a href="/contracting" class="nav-link<%= path === '/contracting' ? ' active' : '' %>">Construction</a></li>
          <li><a href="/seamless-gutters" class="nav-link<%= path === '/seamless-gutters' ? ' active' : '' %>">Seamless Gutters</a></li>
          <li><a href="/excavating" class="nav-link<%= path === '/excavating' ? ' active' : '' %>">Excavating</a></li>
          <li><a href="/about" class="nav-link<%= path === '/about' ? ' active' : '' %>">About</a></li>
          <li><a href="/contact" class="nav-link nav-cta<%= path === '/contact' ? ' active' : '' %>">Contact Us</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- ===== MAIN CONTENT ===== -->
  <main id="main-content">
    <%- body %>
  </main>

  <!-- ===== FOOTER ===== -->
  <footer class="site-footer">
    <div class="footer-inner container">
      <div class="footer-brand">
        <img src="/images/All-Star-V2.png" alt="All Star Contracting Logo" class="footer-logo" />
        <p class="footer-tagline">CNY's Premier Contracting & Gutter Experts</p>
      </div>

      <div class="footer-links">
        <h3 class="footer-heading">Quick Links</h3>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/seamless-gutters">Seamless Gutters</a></li>
          <li><a href="/contracting">Construction</a></li>
          <li><a href="/excavating">Excavating</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact Us</a></li>
        </ul>
      </div>

      <div class="footer-contact">
        <h3 class="footer-heading">Contact Us</h3>
        <p><a href="tel:+13155659230">(315) 565-9230</a></p>
        <p>2913 Milton Ave<br />Solvay, NY 13209</p>
        <p><a href="mailto:allstarguttersjamie@gmail.com">allstarguttersjamie@gmail.com</a></p>
        <a href="https://facebook.com/Allstarseamlessgutters2014/" target="_blank" rel="noopener noreferrer" class="fb-link" aria-label="Facebook">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.79-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.971h-1.513c-1.491 0-1.956.93-1.956 1.886v2.267h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
          </svg>
          Follow Us on Facebook
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="container">
        <p>&copy; <%= new Date().getFullYear() %> All Star Contracting & Seamless Gutters LLC. All rights reserved. | Licensed & Insured</p>
      </div>
    </div>
  </footer>

  <script>
    // ── Hamburger menu ──
    const hamburger = document.getElementById('hamburger');
    const mainNav = document.getElementById('main-nav');

    hamburger.addEventListener('click', function () {
      const isOpen = mainNav.classList.toggle('nav-open');
      hamburger.classList.toggle('ham-open', isOpen);
      hamburger.setAttribute('aria-expanded', isOpen);
    });

    // Close nav when a link is clicked (mobile UX)
    mainNav.querySelectorAll('.nav-link').forEach(function (link) {
      link.addEventListener('click', function () {
        mainNav.classList.remove('nav-open');
        hamburger.classList.remove('ham-open');
        hamburger.setAttribute('aria-expanded', 'false');
      });
    });

    // ── Sticky header shadow ──
    var header = document.getElementById('site-header');
    window.addEventListener('scroll', function () {
      if (window.scrollY > 10) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    });
  </script>
</body>
</html>
